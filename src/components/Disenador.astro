---
/**
 * "Diseña tus aretes": el visitante describe una idea y la API
 * (`POST /api/disenos`) devuelve una imagen de los aretes.
 *
 * Solo se dibuja si hay `API_URL` al compilar, y arranca oculta: el script la
 * muestra cuando la API confirma que el diseñador está disponible.
 */
import { API_URL } from 'astro:env/server';
import { sitio } from '@/config/sitio';
import { IDEA_MAX } from '@/domain/disenos';
import { formatearPrecio } from '@/services/pedidos';
import Icono from './Icono.astro';

const apiUrl = API_URL?.trim().replace(/\/+$/, '');

const ejemplos = [
  'Calaveritas con flores de cempasúchil',
  'Corazón de talavera azul y blanco',
  'Colibrí en rosa mexicano y morado',
  'Nochebuena roja con brillos dorados',
];
---

{
  apiUrl && (
    <section
      class="seccion seccion--alterna disenador"
      id="disena"
      aria-labelledby="disena-titulo"
      data-disenador
      data-api={apiUrl}
      hidden
    >
      <div class="contenedor disenador__rejilla">
        <div class="disenador__texto">
          <p class="disenador__antetitulo">
            <Icono nombre="lapiz" />
            Nuevo
          </p>
          <h2 id="disena-titulo">Diseña tus aretes</h2>
          <p class="disenador__intro">
            Cuéntanos el motivo, los colores y el estilo. Te mostramos cómo quedarían impresos en 3D y, si te gustan, los
            hacemos por <strong>{formatearPrecio(sitio.precios.personalizado)}</strong>.
          </p>

          <form class="disenador__formulario" data-formulario novalidate>
            <label class="disenador__etiqueta" for="disena-idea">
              Tu idea
            </label>
            <textarea
              id="disena-idea"
              name="idea"
              rows="4"
              maxlength={IDEA_MAX}
              required
              placeholder="Por ejemplo: calaveritas con flores de cempasúchil y detalles en rosa mexicano"
              aria-describedby="disena-ayuda disena-error"
              data-idea
            />
            <div class="disenador__ayuda">
              <span id="disena-ayuda">Solo diseños de aretes. Las ideas ofensivas no se aceptan.</span>
              <span data-contador aria-hidden="true">
                0/{IDEA_MAX}
              </span>
            </div>
            <p id="disena-error" class="disenador__error" data-error hidden />

            <div class="disenador__ejemplos">
              <span class="texto-secundario">¿Sin ideas? Prueba con:</span>
              <ul role="list">
                {ejemplos.map((ejemplo) => (
                  <li>
                    <button class="disenador__ejemplo" type="button" data-ejemplo>
                      {ejemplo}
                    </button>
                  </li>
                ))}
              </ul>
            </div>

            <button class="boton boton--principal disenador__generar" type="submit" data-generar>
              <Icono nombre="lapiz" />
              <span data-generar-texto>Crear diseño</span>
            </button>
            <p class="disenador__restantes texto-secundario" data-restantes hidden />
          </form>
        </div>

        <div class="disenador__lienzo" data-lienzo aria-busy="false">
          <div class="disenador__vista disenador__vacio" data-vista="vacio">
            <div class="disenador__marco" aria-hidden="true">
              <span />
              <span />
              <span />
              <span />
            </div>
            <p>Aquí aparecerá tu diseño</p>
          </div>

          <div class="disenador__vista disenador__cargando" data-vista="cargando" hidden>
            <div class="impresora" aria-hidden="true">
              <div class="impresora__pieza">
                <svg viewBox="0 0 120 160" width="120" height="160">
                  <path d="M60 6c9 0 13 7 13 13" fill="none" stroke="#9a96b0" stroke-width="5" stroke-linecap="round" />
                  <circle cx="60" cy="30" r="7" fill="none" stroke="#9a96b0" stroke-width="5" />
                  <rect x="27" y="52" width="66" height="66" rx="13" transform="rotate(45 60 85)" fill="var(--color-rosa)" />
                  <rect x="44" y="69" width="32" height="32" rx="7" transform="rotate(45 60 85)" fill="var(--color-morado)" />
                  <circle cx="60" cy="85" r="6" fill="var(--color-cempasuchil)" />
                </svg>
              </div>
              <div class="impresora__carro">
                <div class="impresora__boquilla" />
              </div>
              <div class="impresora__cama" />
            </div>
            <p class="disenador__estado" data-mensaje>
              Pensando tu diseño…
            </p>
            <p class="texto-secundario disenador__espera">Tarda de 20 a 60 segundos. No cierres la página.</p>
            <div class="disenador__progreso" aria-hidden="true">
              <span data-progreso />
            </div>
          </div>

          <figure class="disenador__vista disenador__resultado" data-vista="resultado" hidden>
            <img data-imagen alt="" width="1024" height="1024" />
            <figcaption class="texto-secundario">Es una propuesta: el arete impreso puede variar un poco.</figcaption>
            <div class="disenador__acciones">
              <a class="boton boton--whatsapp" href="#" target="_blank" rel="noopener" data-pedir>
                <Icono nombre="whatsapp" />
                Pedir este diseño
              </a>
              <a class="boton boton--contorno" href="#" download="aalcuadrado-diseno.webp" data-descargar>
                <Icono nombre="descargar" />
                Descargar
              </a>
            </div>
            <p class="texto-secundario disenador__nota">Descarga la imagen y mándanosla en el chat de WhatsApp.</p>
          </figure>
        </div>

        <p class="visualmente-oculto" aria-live="polite" data-anuncio />
      </div>
    </section>
  )
}

<script>
  import '@/scripts/disenador';
</script>

<style>
  .disenador__rejilla {
    display: grid;
    gap: var(--espacio-7);
    align-items: start;
  }

  .disenador__texto {
    display: grid;
    gap: var(--espacio-4);
  }

  .disenador__antetitulo {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    justify-self: start;
    padding: var(--espacio-1) var(--espacio-3);
    border-radius: var(--radio-pildora);
    background: var(--color-morado-suave);
    color: var(--color-morado);
    font-size: var(--texto-sm);
    font-weight: 700;
  }

  .disenador__antetitulo :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  .disenador__intro {
    font-size: var(--texto-lg);
    color: var(--color-lavanda);
    max-width: 38ch;
  }

  .disenador__formulario {
    display: grid;
    gap: var(--espacio-3);
    margin-top: var(--espacio-2);
  }

  .disenador__etiqueta {
    font-weight: 700;
  }

  textarea {
    width: 100%;
    min-height: 7.5rem;
    padding: var(--espacio-3) var(--espacio-4);
    border: 2px solid var(--color-borde);
    border-radius: var(--radio-md);
    background: var(--color-blanco);
    color: var(--color-tinta);
    font: inherit;
    line-height: 1.5;
    resize: vertical;
    transition: border-color var(--duracion-corta);
  }

  textarea:focus-visible {
    outline: none;
    border-color: var(--color-morado);
    box-shadow: var(--foco);
  }

  textarea[aria-invalid='true'] {
    border-color: var(--color-rosa-oscuro);
  }

  textarea:disabled {
    opacity: 0.6;
  }

  .disenador__ayuda {
    display: flex;
    justify-content: space-between;
    gap: var(--espacio-3);
    color: var(--color-lavanda);
    font-size: var(--texto-xs);
  }

  .disenador__ayuda [data-contador] {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .disenador__error {
    padding: var(--espacio-3) var(--espacio-4);
    border-left: 4px solid var(--color-rosa-oscuro);
    border-radius: var(--radio-sm);
    background: #fde8f2;
    color: #7a0042;
    font-size: var(--texto-sm);
  }

  .disenador__ejemplos {
    display: grid;
    gap: var(--espacio-2);
    font-size: var(--texto-sm);
  }

  .disenador__ejemplos ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
  }

  .disenador__ejemplo {
    min-height: 2.25rem;
    padding: var(--espacio-1) var(--espacio-3);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-pildora);
    background: var(--color-blanco);
    color: var(--color-tinta);
    font: inherit;
    cursor: pointer;
    transition:
      border-color var(--duracion-corta),
      color var(--duracion-corta);
  }

  .disenador__ejemplo:hover {
    border-color: var(--color-morado);
    color: var(--color-morado);
  }

  .disenador__ejemplo:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .disenador__generar {
    justify-self: start;
    margin-top: var(--espacio-2);
  }

  .disenador__generar:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .disenador__restantes {
    font-size: var(--texto-sm);
  }

  /* ---------- Lienzo: vacío, cargando o resultado ---------- */

  .disenador__lienzo {
    display: grid;
    min-height: 22rem;
    padding: var(--espacio-5);
    border-radius: var(--radio-lg);
    background: var(--color-blanco);
    box-shadow: 0 1px 0 var(--color-borde), 0 18px 40px -24px rgb(23 20 43 / 0.35);
  }

  .disenador__vista {
    display: grid;
    gap: var(--espacio-3);
    place-content: center;
    justify-items: center;
    text-align: center;
  }

  .disenador__vista[hidden] {
    display: none;
  }

  .disenador__vacio {
    color: var(--color-lavanda);
  }

  .disenador__marco {
    display: grid;
    grid-template-columns: repeat(2, 1.5rem);
    gap: 0.4rem;
    margin-bottom: var(--espacio-2);
  }

  .disenador__marco span {
    aspect-ratio: 1;
    border-radius: var(--radio-cuadrito);
    background: var(--color-morado-suave);
  }

  .disenador__marco span:nth-child(2) {
    background: var(--color-rosa);
  }

  /* La impresora: una boquilla que va y viene mientras la pieza sube capa por capa. */
  .impresora {
    --capas: 14;
    --duracion: 7s;
    position: relative;
    width: 10rem;
    height: 12rem;
    margin-bottom: var(--espacio-3);
  }

  .impresora__pieza {
    position: absolute;
    inset: 0 0 0.75rem;
    display: grid;
    place-items: end center;
    animation: imprimir var(--duracion) steps(var(--capas), end) infinite;
  }

  .impresora__pieza::after {
    /* Las líneas de cada capa. */
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to top, transparent 0 7px, rgb(255 255 255 / 0.28) 7px 8px);
    pointer-events: none;
  }

  .impresora__pieza svg {
    width: 7.5rem;
    height: auto;
  }

  .impresora__carro {
    position: absolute;
    inset-inline: 0.5rem;
    bottom: 0.75rem;
    height: 0;
    animation: subir var(--duracion) steps(var(--capas), end) infinite;
  }

  .impresora__boquilla {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1.5rem;
    height: 1.75rem;
    border-radius: 0.3rem 0.3rem 0.15rem 0.15rem;
    background: var(--color-tinta);
    clip-path: polygon(0 0, 100% 0, 100% 60%, 65% 60%, 55% 100%, 45% 100%, 35% 60%, 0 60%);
    animation: barrer 0.5s ease-in-out infinite alternate;
  }

  .impresora__boquilla::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-cempasuchil);
    transform: translateX(-50%);
  }

  .impresora__cama {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 0.75rem;
    border-radius: var(--radio-sm);
    background: var(--color-tinta);
  }

  @keyframes imprimir {
    from {
      clip-path: inset(100% 0 0 0);
    }
    85%,
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes subir {
    from {
      transform: translateY(0);
    }
    85%,
    to {
      transform: translateY(-10.5rem);
    }
  }

  @keyframes barrer {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(7.5rem);
    }
  }

  .disenador__estado {
    font-family: var(--fuente-display);
    font-size: var(--texto-lg);
    min-height: 1.5em;
  }

  .disenador__espera {
    font-size: var(--texto-sm);
  }

  .disenador__progreso {
    width: min(16rem, 100%);
    height: 0.375rem;
    margin-top: var(--espacio-2);
    border-radius: var(--radio-pildora);
    background: var(--color-morado-suave);
    overflow: hidden;
  }

  .disenador__progreso span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-morado), var(--color-rosa));
  }

  .disenador__resultado {
    gap: var(--espacio-4);
  }

  .disenador__resultado img {
    width: 100%;
    max-width: 30rem;
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radio-md);
    background: var(--color-alterno);
  }

  .disenador__resultado figcaption,
  .disenador__nota {
    font-size: var(--texto-sm);
  }

  .disenador__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espacio-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .disenador__progreso {
      display: none;
    }
  }

  @media (min-width: 60rem) {
    .disenador__rejilla {
      grid-template-columns: 1fr 1fr;
      gap: var(--espacio-8);
    }

    .disenador__lienzo {
      min-height: 32rem;
      position: sticky;
      top: calc(var(--altura-encabezado) + var(--espacio-5));
    }
  }
</style>
