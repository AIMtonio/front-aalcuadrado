---
import { API_URL } from 'astro:env/server';
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { rutas, type Linea } from '@/config/rutas';
import { sitio } from '@/config/sitio';
import { pedidos } from '@/services/pedidos';

interface Props {
  linea: Linea;
}

const { linea } = Astro.props;

// "Diseña" solo existe si hay API; arranca oculto y lo muestra el diseñador
// cuando la API confirma que está disponible (src/scripts/disenador.ts).
const hayDisenador = Boolean(API_URL?.trim());

type Enlace = { href: string; texto: string; oculto?: boolean };
const enlacesPorLinea: Record<Linea, Enlace[]> = {
  inicio: [],
  aretes: [
    { href: '#catalogo', texto: 'Catálogo' },
    { href: '#galeria', texto: 'Galería' },
    { href: '#personaliza', texto: 'Personaliza' },
    ...(hayDisenador ? [{ href: '#disena', texto: 'Diseña', oculto: true }] : []),
    { href: '#mayoreo', texto: 'Mayoreo' },
    { href: '#preguntas', texto: 'Preguntas' },
  ],
  kits: [
    { href: '#como-funciona', texto: 'Cómo funciona' },
    { href: '#arma-tu-kit', texto: 'Arma tu kit' },
    { href: '#preguntas', texto: 'Preguntas' },
  ],
  velas: [
    { href: '#como-funciona', texto: 'Cómo funciona' },
    { href: '#arma-tu-vela', texto: 'Arma tu vela' },
    { href: '#preguntas', texto: 'Preguntas' },
  ],
};
const enlaces = enlacesPorLinea[linea];

// `corto` es lo que se lee en celulares, donde no caben los nombres completos.
const pestanas = [
  { linea: 'aretes', href: rutas.aretes, texto: 'Aretes', corto: 'Aretes', icono: 'arete' },
  { linea: 'kits', href: rutas.kits, texto: sitio.kits.nombre, corto: 'Kits', icono: 'regalo' },
  { linea: 'velas', href: rutas.velas, texto: 'Velas', corto: 'Velas', icono: 'vela' },
] as const;
---

<header class="encabezado">
  <div class="contenedor encabezado__barra">
    <a class="encabezado__logo" href={rutas.inicio}>
      <Logo />
    </a>

    {
      enlaces.length > 0 ? (
        <>
          <button
            class="encabezado__menu-boton"
            type="button"
            aria-expanded="false"
            aria-controls="menu-principal"
            data-menu-boton
          >
            <Icono nombre="menu" />
            <span class="visualmente-oculto">Abrir menú</span>
          </button>

          <nav class="encabezado__nav" id="menu-principal" aria-label="Secciones" data-menu>
            <ul role="list">
              {enlaces.map((e) => (
                <li hidden={e.oculto} data-enlace-disena={e.oculto ? '' : undefined}>
                  <a href={e.href}>{e.texto}</a>
                </li>
              ))}
            </ul>
            <a class="boton boton--whatsapp boton--chico" href={pedidos.general(linea)} target="_blank" rel="noopener">
              <Icono nombre="whatsapp" />
              Pedir por WhatsApp
            </a>
          </nav>
        </>
      ) : (
        <a class="boton boton--whatsapp boton--chico" href={pedidos.general(linea)} target="_blank" rel="noopener">
          <Icono nombre="whatsapp" />
          WhatsApp
        </a>
      )
    }
  </div>

  <nav class="pestanas" aria-label="Productos">
    <div class="contenedor pestanas__fila">
      <span class="pestanas__titulo" aria-hidden="true">Quiero ver</span>
      <ul class="pestanas__lista" role="list">
        {
          pestanas.map((p) => (
            <li>
              <a
                class="pestana"
                href={p.href}
                aria-current={p.linea === linea ? 'page' : undefined}
                data-linea={p.linea}
              >
                <Icono nombre={p.icono} />
                {p.texto === p.corto ? (
                  p.texto
                ) : (
                  <>
                    <span class="pestana__largo">{p.texto}</span>
                    <span class="pestana__corto" aria-hidden="true">
                      {p.corto}
                    </span>
                  </>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  .encabezado {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgb(255 252 247 / 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-borde);
  }

  .encabezado__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-4);
    min-height: var(--altura-encabezado);
  }

  .encabezado__logo {
    display: inline-flex;
    padding-block: var(--espacio-2);
    text-decoration: none;
    border-radius: var(--radio-sm);
  }

  .encabezado__menu-boton {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: calc(var(--espacio-2) * -1);
    border: 0;
    border-radius: var(--radio-sm);
    background: transparent;
    cursor: pointer;
  }

  .encabezado__nav {
    display: none;
  }

  .encabezado__nav ul a {
    display: block;
    padding: var(--espacio-3) 0;
    font-weight: 500;
    text-decoration: none;
  }

  .encabezado__nav ul a:hover {
    color: var(--color-morado);
  }

  /* ---------- Pestañas: Aretes · Kits navideños · Velas ---------- */

  .pestanas {
    border-top: 1px solid var(--color-borde);
  }

  .pestanas__fila {
    display: flex;
    align-items: center;
    gap: var(--espacio-4);
    min-height: var(--altura-pestanas);
  }

  .pestanas__titulo {
    display: none;
    color: var(--color-lavanda);
    font-size: var(--texto-sm);
  }

  .pestanas__lista {
    display: flex;
    gap: var(--espacio-1);
    padding: 0.1875rem;
    border-radius: var(--radio-pildora);
    background: var(--color-alterno);
    box-shadow: inset 0 0 0 1px var(--color-borde);
  }

  .pestana {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    min-height: 2.5rem;
    padding: 0.375rem 1rem;
    border-radius: var(--radio-pildora);
    font-size: var(--texto-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duracion-corta),
      color var(--duracion-corta);
  }

  .pestana :global(.icono) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .pestana:hover {
    color: var(--color-morado);
  }

  .pestana[aria-current='page'] {
    background: var(--color-morado);
    color: var(--color-blanco);
  }

  .pestana[data-linea='kits'][aria-current='page'] {
    background: var(--color-pino);
  }

  .pestana[data-linea='velas'][aria-current='page'] {
    background: var(--color-cera);
  }

  /* Celulares chicos: nombres cortos y sin "Quiero ver" para que quepan las tres. */
  .pestana__corto {
    display: none;
  }

  @media (max-width: 29.99rem) {
    .pestana {
      padding-inline: 0.75rem;
    }

    .pestana__largo {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .pestana__corto {
      display: inline;
    }
  }

  @media (min-width: 30rem) {
    .pestanas__titulo {
      display: inline;
    }
  }

  /* Móvil: menú desplegable */
  @media (max-width: 59.99rem) {
    .encabezado__nav[data-abierto] {
      display: grid;
      gap: var(--espacio-4);
      position: absolute;
      inset: 100% 0 auto;
      padding: var(--espacio-3) var(--margen-lateral) var(--espacio-6);
      background: var(--color-papel);
      border-bottom: 1px solid var(--color-borde);
      box-shadow: 0 24px 40px -24px rgb(23 20 43 / 0.25);
    }

    .encabezado__nav ul a {
      font-size: var(--texto-lg);
      border-bottom: 1px solid var(--color-alterno);
    }

    .encabezado__nav .boton {
      justify-self: start;
    }
  }

  @media (min-width: 60rem) {
    .encabezado__menu-boton {
      display: none;
    }

    .encabezado__nav .boton {
      white-space: nowrap;
    }

    .encabezado__nav {
      display: flex;
      align-items: center;
      gap: var(--espacio-6);
    }

    .encabezado__nav ul {
      display: flex;
      gap: var(--espacio-5);
    }

    .encabezado__nav ul a {
      padding: var(--espacio-2) 0;
      font-size: var(--texto-sm);
    }
  }

  /* Pantallas medianas: menos aire entre enlaces para que quepan todos en una línea. */
  @media (min-width: 60rem) and (max-width: 71.99rem) {
    .encabezado__nav {
      gap: var(--espacio-4);
    }

    .encabezado__nav ul {
      gap: var(--espacio-4);
    }
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (boton && menu) {
    const etiqueta = boton.querySelector('.visualmente-oculto');

    const alternar = (abrir: boolean) => {
      boton.setAttribute('aria-expanded', String(abrir));
      menu.toggleAttribute('data-abierto', abrir);
      if (etiqueta) etiqueta.textContent = abrir ? 'Cerrar menú' : 'Abrir menú';
    };

    boton.addEventListener('click', () => alternar(boton.getAttribute('aria-expanded') !== 'true'));

    // Cerrar al elegir un enlace, con Escape o al tocar fuera.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) alternar(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        alternar(false);
        boton.focus();
      }
    });
    document.addEventListener('click', (e) => {
      const objetivo = e.target as Node;
      if (!menu.contains(objetivo) && !boton.contains(objetivo)) alternar(false);
    });
  }
</script>
