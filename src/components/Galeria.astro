---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { FotoGaleria } from '@/domain/catalogo';

interface Props {
  fotos: FotoGaleria<ImageMetadata>[];
}

const { fotos } = Astro.props;
---

{
  fotos.length > 0 && (
    <section class="seccion seccion--alterna" id="galeria" aria-labelledby="galeria-titulo">
      <div class="contenedor">
        <div class="encabezado-seccion">
          <h2 id="galeria-titulo">Así se ven</h2>
          <p>En el puesto, en su caja y recién salidos de la impresora.</p>
        </div>

        <ul class="mosaico" role="list">
          {fotos.map((foto, i) => (
            <li>
              <a href={`#galeria/${i + 1}`} class="mosaico__foto">
                <Picture
                  src={foto.src}
                  alt={foto.alt}
                  formats={['avif', 'webp']}
                  widths={[320, 480, 640, 900]}
                  sizes="(min-width: 76rem) 24rem, (min-width: 60rem) 31vw, (min-width: 36rem) 46vw, 46vw"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  /* Mosaico con alturas variadas: cada foto conserva su proporción. */
  .mosaico {
    columns: 2;
    column-gap: var(--espacio-3);
  }

  .mosaico li {
    break-inside: avoid;
    margin-bottom: var(--espacio-3);
  }

  .mosaico__foto {
    display: block;
    border-radius: var(--radio-md);
    overflow: hidden;
    cursor: zoom-in;
  }

  .mosaico__foto :global(img) {
    width: 100%;
    transition: transform var(--duracion-media) var(--curva-salida);
  }

  .mosaico__foto:hover :global(img) {
    transform: scale(1.03);
  }

  @media (min-width: 60rem) {
    .mosaico {
      columns: 3;
      column-gap: var(--espacio-5);
    }

    .mosaico li {
      margin-bottom: var(--espacio-5);
    }
  }
</style>
