---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { FotoGaleria } from '@/domain/catalogo';

interface Props {
  fotos: FotoGaleria<ImageMetadata>[];
  /** Por defecto, "Así se ven" de la página de aretes. */
  id?: string;
  titulo?: string;
  texto?: string;
  /** Si cada foto abre el visor (`#<id>/<n>`). Solo donde la página tiene `<Visor>`. */
  ampliar?: boolean;
}

const {
  fotos,
  id = 'galeria',
  titulo = 'Así se ven',
  texto = 'En el puesto, en su caja y recién salidos de la impresora.',
  ampliar = true,
} = Astro.props;
---

{
  fotos.length > 0 && (
    <section class="seccion seccion--alterna" id={id} aria-labelledby={`${id}-titulo`}>
      <div class="contenedor">
        <div class="encabezado-seccion">
          <h2 id={`${id}-titulo`}>{titulo}</h2>
          <p>{texto}</p>
        </div>

        <ul class="mosaico" role="list">
          {fotos.map((foto, i) => {
            const imagen = (
              <Picture
                src={foto.src}
                alt={foto.alt}
                formats={['avif', 'webp']}
                widths={[320, 480, 640, 900]}
                sizes="(min-width: 76rem) 24rem, (min-width: 60rem) 31vw, (min-width: 36rem) 46vw, 46vw"
                loading="lazy"
                decoding="async"
              />
            );
            return (
              <li>
                {ampliar ? (
                  <a href={`#${id}/${i + 1}`} class="mosaico__foto">
                    {imagen}
                  </a>
                ) : (
                  <div class="mosaico__foto mosaico__foto--fija">{imagen}</div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  /* Mosaico con alturas variadas: cada foto conserva su proporción. */
  .mosaico {
    columns: 2;
    column-gap: var(--espacio-3);
  }

  .mosaico li {
    break-inside: avoid;
    margin-bottom: var(--espacio-3);
  }

  .mosaico__foto {
    display: block;
    border-radius: var(--radio-md);
    overflow: hidden;
    cursor: zoom-in;
  }

  .mosaico__foto :global(img) {
    width: 100%;
    transition: transform var(--duracion-media) var(--curva-salida);
  }

  .mosaico__foto--fija {
    cursor: default;
  }

  a.mosaico__foto:hover :global(img) {
    transform: scale(1.03);
  }

  @media (min-width: 60rem) {
    .mosaico {
      columns: 3;
      column-gap: var(--espacio-5);
    }

    .mosaico li {
      margin-bottom: var(--espacio-5);
    }
  }
</style>
