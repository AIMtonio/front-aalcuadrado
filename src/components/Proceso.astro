---
/** Pasos numerados ("Cómo se hacen", "Cómo funciona"). Cada página manda los suyos. */
interface Props {
  id: string;
  titulo: string;
  introduccion?: string;
  pasos: { titulo: string; texto: string }[];
  /** Párrafo al final, separado por una línea. */
  firma?: string;
  alterna?: boolean;
}

const { id, titulo, introduccion, pasos, firma, alterna = false } = Astro.props;
---

<section class:list={['seccion', { 'seccion--alterna': alterna }]} id={id} aria-labelledby={`${id}-titulo`}>
  <div class="contenedor">
    <div class="encabezado-seccion">
      <h2 id={`${id}-titulo`}>{titulo}</h2>
      {introduccion && <p>{introduccion}</p>}
    </div>
    <ol class="pasos" role="list">
      {
        pasos.map((paso, i) => (
          <li class="paso">
            <span class="paso__numero" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{paso.titulo}</h3>
            <p>{paso.texto}</p>
          </li>
        ))
      }
    </ol>

    {firma && <p class="proceso__firma">{firma}</p>}
  </div>
</section>

<style>
  .pasos {
    display: grid;
    gap: var(--espacio-6);
    counter-reset: paso;
  }

  .paso {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--espacio-2) var(--espacio-4);
    align-items: baseline;
  }

  .paso__numero {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radio-sm);
    background: var(--color-morado);
    color: var(--color-blanco);
    font-family: var(--fuente-display);
    font-weight: 700;
    font-size: var(--texto-lg);
    align-self: start;
  }

  .paso p {
    color: var(--color-lavanda);
    max-width: 36ch;
  }

  .proceso__firma {
    margin-top: var(--espacio-7);
    padding-top: var(--espacio-5);
    border-top: 1px solid var(--color-borde);
    max-width: var(--medida);
    font-size: var(--texto-lg);
  }

  @media (min-width: 60rem) {
    .pasos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--espacio-7);
    }

    .paso {
      grid-template-columns: 1fr;
      align-items: start;
      align-content: start;
    }

    .paso__numero {
      grid-row: auto;
      margin-bottom: var(--espacio-3);
    }
  }
</style>
