---
/**
 * "Arma tu kit": quien visita elige jabón y vela, deja su contacto y el pedido
 * se manda a la API (`POST /api/pedidos`). Sin `API_URL` al compilar, el mismo
 * formulario manda el pedido por WhatsApp.
 */
import { API_URL } from 'astro:env/server';
import { sitio } from '@/config/sitio';
import { catalogo } from '@/data';
import { MAXIMOS } from '@/domain/kits';
import { pedidos } from '@/services/pedidos';
import Icono from '@/components/Icono.astro';
import VistaKit from './VistaKit.astro';

const apiUrl = API_URL?.trim().replace(/\/+$/, '') || undefined;
// Colores y aromas: los del panel (pestaña Kits) o, sin API, los de sitio.kits. Formas y toppings son fijos.
const opciones = await catalogo.opcionesKit();
const jabon = { ...sitio.kits.jabon, ...opciones.jabon };
const vela = { ...sitio.kits.vela, ...opciones.vela };

/** "1 vela aromática en frasco, 2 jabones artesanales y 1 nacimiento pequeño". */
const contenido = new Intl.ListFormat('es', { type: 'conjunction' }).format(
  sitio.kits.contenido.map((c) => `${c.cantidad} ${c.nombre}`),
);

type Opcion = { nombre: string; hex?: string; figura?: string };
const grupos: { titulo: string; nota?: string; campos: { campo: string; etiqueta: string; opciones: readonly Opcion[] }[] }[] = [
  {
    titulo: 'Tus 2 jabones',
    nota: 'Los dos salen iguales: misma forma, color y aroma.',
    campos: [
      { campo: 'jabonColor', etiqueta: 'Color', opciones: jabon.colores },
      { campo: 'jabonAroma', etiqueta: 'Aroma', opciones: jabon.aromas.map((nombre) => ({ nombre })) },
      { campo: 'jabonForma', etiqueta: 'Forma', opciones: jabon.formas },
    ],
  },
  {
    titulo: 'Tu vela',
    nota: `Pesa ${sitio.kits.vela.gramos} g y dura aproximadamente de ${sitio.kits.vela.duracionHoras} horas encendida.`,
    campos: [
      { campo: 'velaColor', etiqueta: 'Color', opciones: vela.colores },
      { campo: 'velaAroma', etiqueta: 'Aroma', opciones: vela.aromas.map((nombre) => ({ nombre })) },
      { campo: 'velaTopping', etiqueta: 'Topping', opciones: vela.toppings },
    ],
  },
];

// Resumen junto a la vista previa: primero los jabones y abajo la vela.
const resumen = [
  {
    titulo: '2 jabones',
    campos: [
      { campo: 'jabonColor', texto: 'Color' },
      { campo: 'jabonAroma', texto: 'Aroma' },
      { campo: 'jabonForma', texto: 'Forma' },
    ],
  },
  {
    titulo: `Vela de ${sitio.kits.vela.gramos} g`,
    campos: [
      { campo: 'velaColor', texto: 'Color' },
      { campo: 'velaAroma', texto: 'Aroma' },
      { campo: 'velaTopping', texto: 'Topping' },
    ],
  },
];
// Primera opción de cada grupo: el kit arranca completo y la vista previa no sale vacía.
const inicial = Object.fromEntries(grupos.flatMap((g) => g.campos.map((c) => [c.campo, c.opciones[0]!.nombre])));
---

<section class="seccion seccion--alterna arma" id="arma-tu-kit" aria-labelledby="arma-titulo">
  <div class="contenedor">
    <div class="encabezado-seccion">
      <h2 id="arma-titulo">Arma tu kit</h2>
      <p>
        Cada kit trae {contenido}. Elige cómo quieres tus jabones y tu vela; te escribimos para confirmar el precio y
        tu kit está listo en {sitio.kits.entrega}.
      </p>
    </div>

    <form class="arma__rejilla" data-kit data-api={apiUrl} novalidate>
      <div class="arma__opciones">
        {
          grupos.map((grupo) => (
            <fieldset class="arma__grupo">
              <legend>{grupo.titulo}</legend>
              {grupo.nota && <p class="arma__nota-grupo">{grupo.nota}</p>}
              {grupo.campos.map(({ campo, etiqueta, opciones }) => (
                <fieldset class="arma__campo" aria-describedby={`error-${campo}`} data-campo={campo}>
                  <legend>{etiqueta}</legend>
                  <div class="fichas">
                    {opciones.map((o, i) => (
                      <label class="ficha">
                        <input
                          type="radio"
                          name={campo}
                          value={o.nombre}
                          checked={i === 0}
                          data-hex={o.hex}
                          data-figura={o.figura}
                        />
                        {o.hex && <span class="ficha__muestra" style={`--muestra:${o.hex}`} aria-hidden="true" />}
                        <span>{o.nombre}</span>
                      </label>
                    ))}
                  </div>
                  <p class="arma__error" id={`error-${campo}`} data-error={campo} hidden />
                </fieldset>
              ))}
            </fieldset>
          ))
        }

        <fieldset class="arma__grupo">
          <legend>Tus datos</legend>
          <div class="arma__datos">
            <div class="arma__texto">
              <label for="kit-nombre">Nombre</label>
              <input
                id="kit-nombre"
                name="clienteNombre"
                type="text"
                autocomplete="name"
                maxlength={MAXIMOS.clienteNombre}
                required
                aria-describedby="error-clienteNombre"
                data-campo="clienteNombre"
              />
              <p class="arma__error" id="error-clienteNombre" data-error="clienteNombre" hidden />
            </div>
            <div class="arma__texto">
              <label for="kit-contacto">Correo o teléfono</label>
              <input
                id="kit-contacto"
                name="clienteContacto"
                type="text"
                inputmode="email"
                autocomplete="email"
                maxlength={MAXIMOS.clienteContacto}
                required
                placeholder="ana@correo.com o 999 123 4567"
                aria-describedby="kit-contacto-ayuda error-clienteContacto"
                data-campo="clienteContacto"
              />
              <p class="arma__ayuda" id="kit-contacto-ayuda">Solo lo usamos para cotizar tu kit.</p>
              <p class="arma__error" id="error-clienteContacto" data-error="clienteContacto" hidden />
            </div>
          </div>
        </fieldset>

        <p class="arma__aviso" role="alert" data-aviso hidden></p>

        <div class="arma__enviar">
          <button class="boton boton--navidad" type="submit" data-enviar>
            <Icono nombre={apiUrl ? 'palomita' : 'whatsapp'} />
            <span data-enviar-texto>{apiUrl ? 'Mandar mi pedido' : 'Pedir por WhatsApp'}</span>
          </button>
          <a class="boton boton--contorno" href={pedidos.general('kits')} target="_blank" rel="noopener" data-whatsapp hidden>
            <Icono nombre="whatsapp" />
            Mandarlo por WhatsApp
          </a>
        </div>
      </div>

      <aside class="arma__vista" aria-labelledby="arma-vista-titulo">
        <h3 id="arma-vista-titulo" class="visualmente-oculto">Tu kit</h3>
        <div class="arma__lienzo">
          <VistaKit
            jabon={jabon.colores[0]!.hex}
            vela={vela.colores[0]!.hex}
            forma={jabon.formas[0]!.figura}
            topping={vela.toppings[0]!.figura}
          />
        </div>
        <div class="arma__resumen" aria-live="polite">
          {
            resumen.map((grupo) => (
              <div class="arma__resumen-grupo">
                <p class="arma__resumen-titulo">{grupo.titulo}</p>
                <dl>
                  {grupo.campos.map(({ campo, texto }) => (
                    <div>
                      <dt>{texto}</dt>
                      <dd data-resumen={campo}>{inicial[campo]}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))
          }
        </div>
        <div class="arma__incluye">
          <p>Tu kit trae</p>
          <ul role="list">
            {
              sitio.kits.contenido.map((c) => (
                <li>
                  <span class="arma__cantidad">{c.cantidad}</span> {c.nombre}
                </li>
              ))
            }
          </ul>
        </div>
        <p class="arma__nota">Es una idea de cómo se verá: cada pieza se hace a mano y puede variar un poco.</p>
      </aside>
    </form>

    <div class="arma__listo" data-listo tabindex="-1" hidden>
      <span class="arma__listo-icono" aria-hidden="true"><Icono nombre="palomita" /></span>
      <h3 data-listo-titulo>¡Recibimos tu pedido!</h3>
      <p data-listo-texto>Te escribimos pronto para confirmar el precio. Tu kit estará listo en {sitio.kits.entrega}.</p>
      <div class="arma__listo-acciones">
        <a class="boton boton--whatsapp" href={pedidos.general('kits')} target="_blank" rel="noopener" data-listo-whatsapp>
          <Icono nombre="whatsapp" />
          Avisar por WhatsApp
        </a>
        <button class="boton boton--contorno" type="button" data-otro>Armar otro kit</button>
      </div>
    </div>
  </div>
</section>

<script>
  import '@/scripts/kit';
</script>

<style>
  .arma__rejilla {
    display: grid;
    gap: var(--espacio-7);
    align-items: start;
  }

  .arma__rejilla[hidden] {
    display: none;
  }

  .arma__opciones {
    display: grid;
    gap: var(--espacio-6);
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .arma__grupo {
    display: grid;
    gap: var(--espacio-5);
    padding: var(--espacio-5);
    border-radius: var(--radio-lg);
    background: var(--color-blanco);
    box-shadow: 0 1px 0 var(--color-borde);
  }

  .arma__grupo > legend {
    float: left; /* deja que la leyenda forme parte de la rejilla */
    width: 100%;
    font-family: var(--fuente-display);
    font-size: var(--texto-lg);
    font-weight: 600;
  }

  .arma__campo {
    display: grid;
    gap: var(--espacio-3);
  }

  .arma__campo > legend {
    float: left;
    width: 100%;
    margin-bottom: var(--espacio-3);
    font-weight: 700;
    font-size: var(--texto-sm);
  }

  .fichas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
  }

  .ficha {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--color-borde);
    border-radius: var(--radio-pildora);
    background: var(--color-papel);
    font-size: var(--texto-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color var(--duracion-corta),
      background-color var(--duracion-corta);
  }

  .ficha:hover {
    border-color: var(--color-pino);
  }

  .ficha input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .ficha:has(input:checked) {
    border-color: var(--color-pino);
    background: var(--color-pino);
    color: var(--color-blanco);
  }

  .ficha:has(input:focus-visible) {
    outline: 3px solid var(--color-pino);
    outline-offset: 3px;
  }

  .ficha__muestra {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: var(--radio-cuadrito);
    background: var(--muestra);
    box-shadow: inset 0 0 0 1px rgb(23 20 43 / 0.2);
  }

  .ficha:has(input:checked) .ficha__muestra {
    box-shadow: 0 0 0 2px var(--color-blanco);
  }

  .arma__datos {
    display: grid;
    gap: var(--espacio-4);
  }

  .arma__texto {
    display: grid;
    gap: var(--espacio-2);
  }

  .arma__texto label {
    font-weight: 700;
    font-size: var(--texto-sm);
  }

  .arma__texto input {
    width: 100%;
    min-height: 3rem;
    padding: var(--espacio-2) var(--espacio-4);
    border: 2px solid var(--color-borde);
    border-radius: var(--radio-md);
    background: var(--color-papel);
    color: var(--color-tinta);
    font: inherit;
    transition: border-color var(--duracion-corta);
  }

  .arma__texto input:focus-visible {
    outline: none;
    border-color: var(--color-pino);
    box-shadow: 0 0 0 3px var(--color-blanco), 0 0 0 5px var(--color-pino);
  }

  .arma__texto input[aria-invalid='true'] {
    border-color: var(--color-rojo);
  }

  .arma__ayuda {
    color: var(--color-lavanda);
    font-size: var(--texto-xs);
  }

  .arma__error {
    color: var(--color-rojo);
    font-size: var(--texto-sm);
    font-weight: 500;
  }

  .arma__aviso {
    padding: var(--espacio-3) var(--espacio-4);
    border-left: 4px solid var(--color-rojo);
    border-radius: var(--radio-sm);
    background: #fbe9ea;
    color: #7d141b;
    font-size: var(--texto-sm);
  }

  .arma__enviar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3);
  }

  .arma__enviar [data-enviar]:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  /* ---------- Vista previa ---------- */

  .arma__vista {
    display: grid;
    gap: var(--espacio-4);
    padding: var(--espacio-5);
    border-radius: var(--radio-lg);
    background: var(--color-blanco);
    box-shadow: 0 1px 0 var(--color-borde), 0 18px 40px -24px rgb(23 20 43 / 0.35);
  }

  .arma__lienzo {
    padding: var(--espacio-4) var(--espacio-2) var(--espacio-2);
    border-radius: var(--radio-md);
    background:
      radial-gradient(circle at 50% 30%, rgb(201 162 39 / 0.14), transparent 60%),
      var(--color-alterno);
  }

  .arma__resumen {
    display: grid;
    gap: var(--espacio-4);
    font-size: var(--texto-sm);
  }

  .arma__resumen-grupo {
    display: grid;
    gap: var(--espacio-2);
  }

  .arma__resumen-grupo + .arma__resumen-grupo {
    padding-top: var(--espacio-4);
    border-top: 1px solid var(--color-borde);
  }

  .arma__resumen-titulo {
    font-family: var(--fuente-display);
    font-weight: 600;
  }

  .arma__resumen dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--espacio-3);
    margin: 0;
  }

  .arma__resumen dt {
    color: var(--color-lavanda);
    font-size: var(--texto-xs);
  }

  .arma__resumen dd {
    margin: 0;
    font-weight: 700;
  }

  .arma__nota-grupo {
    margin-top: calc(var(--espacio-3) * -1);
    color: var(--color-lavanda);
    font-size: var(--texto-sm);
  }

  .arma__incluye {
    display: grid;
    gap: var(--espacio-2);
    padding-top: var(--espacio-4);
    border-top: 1px solid var(--color-borde);
    font-size: var(--texto-sm);
  }

  .arma__incluye > p {
    color: var(--color-lavanda);
    font-size: var(--texto-xs);
  }

  .arma__incluye ul {
    display: grid;
    gap: var(--espacio-1);
  }

  .arma__cantidad {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    margin-right: var(--espacio-1);
    border-radius: var(--radio-cuadrito);
    background: var(--color-pino);
    color: var(--color-blanco);
    font-weight: 700;
    font-size: var(--texto-xs);
  }

  .arma__nota {
    color: var(--color-lavanda);
    font-size: var(--texto-xs);
  }

  /* ---------- Pedido recibido ---------- */

  .arma__listo {
    display: grid;
    gap: var(--espacio-4);
    justify-items: center;
    max-width: 36rem;
    margin-inline: auto;
    padding: var(--espacio-7) var(--espacio-5);
    border-radius: var(--radio-lg);
    background: var(--color-blanco);
    text-align: center;
    box-shadow: 0 1px 0 var(--color-borde);
  }

  .arma__listo[hidden] {
    display: none;
  }

  .arma__listo:focus {
    outline: none;
  }

  .arma__listo p {
    color: var(--color-lavanda);
    font-size: var(--texto-lg);
  }

  .arma__listo-icono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radio-md);
    background: var(--color-pino);
    color: var(--color-blanco);
  }

  .arma__listo-acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espacio-3);
    margin-top: var(--espacio-2);
  }

  /* Celular: el kit va arriba para ver cómo queda antes de elegir. */
  @media (max-width: 59.99rem) {
    .arma__vista {
      order: -1;
    }
  }

  @media (min-width: 40rem) {
    .arma__datos {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  @media (min-width: 60rem) {
    .arma__rejilla {
      grid-template-columns: 1.25fr 1fr;
      gap: var(--espacio-7);
    }

    .arma__vista {
      position: sticky;
      top: calc(var(--altura-encabezado) + var(--altura-pestanas) + var(--espacio-5));
    }
  }
</style>
