---
/**
 * "Así se ven": fotos de cada tipo de vela (pestaña Velas del panel), en el orden
 * del panel. Cada foto abre el visor (`#velas-<tipo>/<n>`). Sin fotos, la sección no sale.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { FotoGaleria } from '@/domain/catalogo';
import { NOMBRES_TIPO_VELA, TIPOS_VELA, type TipoVela } from '@/domain/velas';
import { sitio } from '@/config/sitio';

interface Props {
  fotos: Record<TipoVela, FotoGaleria<ImageMetadata>[]>;
}

const { fotos } = Astro.props;
const grupos = TIPOS_VELA.filter((tipo) => fotos[tipo].length > 0).map((tipo) => ({ tipo, fotos: fotos[tipo] }));
---

{
  grupos.length > 0 && (
    <section class="seccion seccion--alterna" id="asi-se-ven" aria-labelledby="asi-se-ven-titulo">
      <div class="contenedor">
        <div class="encabezado-seccion">
          <h2 id="asi-se-ven-titulo">Así se ven</h2>
          <p>Algunas velas que ya hicimos. La tuya la vertimos con el color, el aroma y el topping que elijas.</p>
        </div>

        <div class="fotos-velas">
          {grupos.map(({ tipo, fotos }) => (
            <section class="fotos-velas__tipo" aria-labelledby={`fotos-${tipo}`}>
              <div class="fotos-velas__encabezado">
                <h3 id={`fotos-${tipo}`}>{NOMBRES_TIPO_VELA[tipo]}</h3>
                <p>{sitio.velas.tipos[tipo].descripcion}</p>
              </div>
              <ul class="fotos-velas__fila" role="list">
                {fotos.map((foto, i) => (
                  <li>
                    <a href={`#velas-${tipo}/${i + 1}`} class="fotos-velas__foto">
                      <Picture
                        src={foto.src}
                        alt={foto.alt}
                        formats={['avif', 'webp']}
                        widths={[280, 420, 640]}
                        sizes="(min-width: 60rem) 18rem, 62vw"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .fotos-velas {
    display: grid;
    gap: var(--espacio-7);
  }

  .fotos-velas__tipo {
    display: grid;
    gap: var(--espacio-4);
  }

  .fotos-velas__encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--espacio-1) var(--espacio-4);
  }

  .fotos-velas__encabezado h3 {
    font-size: var(--texto-xl);
  }

  .fotos-velas__encabezado p {
    color: var(--color-lavanda);
  }

  /* Una fila que se desliza de lado: así cada tipo ocupa poco aunque tenga muchas fotos. */
  .fotos-velas__fila {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62vw, 18rem);
    gap: var(--espacio-3);
    margin-inline: calc(var(--margen-lateral) * -1);
    padding-inline: var(--margen-lateral);
    padding-bottom: var(--espacio-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margen-lateral);
    overscroll-behavior-x: contain;
  }

  .fotos-velas__fila li {
    scroll-snap-align: start;
  }

  .fotos-velas__foto {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radio-md);
    overflow: hidden;
    cursor: zoom-in;
  }

  .fotos-velas__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duracion-media) var(--curva-salida);
  }

  .fotos-velas__foto:hover :global(img) {
    transform: scale(1.03);
  }
</style>
