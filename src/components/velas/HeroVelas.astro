---
import { sitio } from '@/config/sitio';
import { NOMBRES_TIPO_VELA, type OpcionesVela } from '@/domain/velas';
import { pedidos } from '@/services/pedidos';
import Icono from '@/components/Icono.astro';
import VistaVela from './VistaVela.astro';

interface Props {
  tipos: OpcionesVela['tipos'];
}

const { tipos } = Astro.props;
---

<section class="hero-velas" id="inicio" aria-labelledby="hero-velas-titulo">
  <div class="contenedor hero-velas__rejilla">
    <div class="hero-velas__texto">
      <p class="hero-velas__antetitulo">Hechas a mano, una por una</p>
      <h1 id="hero-velas-titulo">{sitio.velas.nombre}</h1>
      <p class="hero-velas__subtitulo">
        Tú eliges el tipo, el tamaño, el color, el aroma y el topping; nosotros la vertimos a mano. Lista en{' '}
        {sitio.velas.entrega}.
      </p>
      <ul class="hero-velas__tipos" role="list" aria-label="Tipos de vela">
        {tipos.map(({ tipo }) => <li>{NOMBRES_TIPO_VELA[tipo]}</li>)}
      </ul>
      <div class="hero-velas__acciones">
        <a class="boton boton--claro" href="#arma-tu-vela">Arma tu vela</a>
        <a class="boton boton--contorno-claro" href={pedidos.general('velas')} target="_blank" rel="noopener">
          <Icono nombre="whatsapp" />
          Pregunta por WhatsApp
        </a>
      </div>
    </div>

    <div
      class="hero-velas__dibujo"
      role="img"
      aria-label="Dibujo de tres velas: una en frasco, marmoleada en rosa y blanco con flores secas; una tipo cupcake color lavanda con granos de café; y una en jícara color miel con anís estrella"
    >
      <VistaVela class="hero-velas__vela hero-velas__vela--chica" tipo="molde" vela="#B7A4E0" topping="cafe" />
      <VistaVela class="hero-velas__vela" tipo="recipiente" vela="#F4EFE6" veta="#E4007C" topping="flores" escala={1.1} />
      <VistaVela class="hero-velas__vela hero-velas__vela--chica" tipo="jicara" vela="#E8B04A" topping="anis" escala={0.9} />
    </div>
  </div>
</section>

<style>
  .hero-velas {
    --boton-acento: var(--color-cera);
    padding-block: var(--espacio-7) var(--espacio-seccion);
    background:
      radial-gradient(circle at 80% 25%, rgb(242 163 58 / 0.28), transparent 45%),
      var(--color-cera);
    color: var(--color-blanco);
  }

  .hero-velas__rejilla {
    display: grid;
    gap: var(--espacio-7);
    align-items: center;
  }

  .hero-velas__texto {
    display: grid;
    gap: var(--espacio-5);
    justify-items: start;
  }

  .hero-velas__antetitulo {
    padding: var(--espacio-1) var(--espacio-3);
    border-radius: var(--radio-pildora);
    background: rgb(255 255 255 / 0.16);
    font-size: var(--texto-sm);
    font-weight: 700;
  }

  .hero-velas h1 {
    max-width: 12ch;
  }

  .hero-velas__subtitulo {
    max-width: 40ch;
    font-size: var(--texto-lg);
    color: rgb(255 255 255 / 0.9);
  }

  .hero-velas__tipos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
  }

  .hero-velas__tipos li {
    padding: var(--espacio-1) var(--espacio-3);
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: var(--radio-pildora);
    font-size: var(--texto-sm);
  }

  .hero-velas__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3);
    margin-top: var(--espacio-2);
  }

  .hero-velas :focus-visible {
    outline-color: var(--color-blanco);
  }

  .hero-velas__dibujo {
    display: grid;
    grid-template-columns: 1fr 1.25fr 1fr;
    align-items: end;
    padding: var(--espacio-6) var(--espacio-4) var(--espacio-4);
    border-radius: var(--radio-lg);
    background: var(--color-papel);
  }

  .hero-velas__dibujo :global(.hero-velas__vela--chica) {
    margin-inline: -8%;
  }

  @media (min-width: 60rem) {
    .hero-velas {
      padding-top: var(--espacio-8);
    }

    .hero-velas__rejilla {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--espacio-8);
    }
  }
</style>
