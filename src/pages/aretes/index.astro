---
import { getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Temporada from '@/components/Temporada.astro';
import Catalogo from '@/components/catalogo/Catalogo.astro';
import Galeria from '@/components/Galeria.astro';
import Proceso from '@/components/Proceso.astro';
import Beneficios from '@/components/Beneficios.astro';
import Personaliza from '@/components/Personaliza.astro';
import Disenador from '@/components/Disenador.astro';
import Mayoreo from '@/components/Mayoreo.astro';
import Preguntas from '@/components/Preguntas.astro';
import Visor from '@/components/visor/Visor.astro';
import { elementoDeGaleria, elementoDeProducto } from '@/components/visor/datos';
import { catalogo } from '@/data';
import { rutas } from '@/config/rutas';
import { sitio } from '@/config/sitio';

// Toda la información pasa por el repositorio; la página no lee archivos.
const [productos, colecciones, categorias, fotosGaleria] = await Promise.all([
  catalogo.listarProductos(),
  catalogo.listarColecciones(),
  catalogo.listarCategorias(),
  catalogo.listarFotosGaleria(),
]);

const destacado = productos.find((p) => p.destacado && p.disponible) ?? productos.find((p) => p.disponible) ?? productos[0];
/** URL absoluta de esta página: los enlaces de WhatsApp y del visor apuntan aquí. */
const urlSitio = new URL(rutas.aretes, Astro.site).href;

const pasos = [
  {
    titulo: 'Diseño digital',
    texto: 'Cada motivo se dibuja en la computadora: se ajustan los calados y el grosor para que el arete sea ligero y firme.',
  },
  {
    titulo: 'Impresión 3D, capa por capa',
    texto: 'La impresora levanta la pieza en capas de décimas de milímetro. Así salen detalles que a mano serían imposibles.',
  },
  {
    titulo: 'Armado y revisión a mano',
    texto: 'Se limpia cada pieza, se le pone el gancho y se revisa par por par antes de llegar a ti.',
  },
];

const elementosVisor = await Promise.all([
  ...productos.map(elementoDeProducto),
  ...(fotosGaleria.length ? [elementoDeGaleria(fotosGaleria, 'galeria', 'Así se ven')] : []),
]);

// Datos estructurados de cada producto para buscadores.
const productosJsonLd = await Promise.all(
  productos.map(async (p) => {
    const imagenes = await Promise.all(
      p.fotos.slice(0, 3).map(async (f) => new URL((await getImage({ src: f.src, width: 1200, format: 'jpg' })).src, Astro.site).href),
    );
    return {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: p.nombre,
      description: p.descripcion || `Aretes ${p.nombre} impresos en 3D por ${sitio.nombre}.`,
      image: imagenes,
      url: `${urlSitio}#producto/${p.slug}`,
      brand: { '@type': 'Brand', name: sitio.nombre },
      material: 'PLA',
      ...(p.colores.length && { color: p.colores.map((c) => c.nombre).join(', ') }),
      ...(p.precio !== undefined && {
        offers: {
          '@type': 'Offer',
          price: p.precio.toFixed(2),
          priceCurrency: 'MXN',
          availability: p.disponible ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
          url: `${urlSitio}#producto/${p.slug}`,
        },
      }),
    };
  }),
);

const coleccionTemporadaConProductos = colecciones.some((c) => c.id === sitio.temporada.coleccion);
---

<Base
  linea="aretes"
  titulo={`Aretes mexicanos impresos en 3D · ${sitio.nombre}`}
  descripcion="Aretes con motivos mexicanos, diseñados e impresos en 3D. Ligeros, resistentes y en los colores que elijas. Pide por WhatsApp."
  jsonLd={productosJsonLd}
>
  <Hero destacado={destacado} />
  <Temporada hayProductos={coleccionTemporadaConProductos} />
  <Catalogo productos={productos} colecciones={colecciones} categorias={categorias} urlSitio={urlSitio} />
  <Galeria fotos={fotosGaleria} />
  <Proceso
    id="proceso"
    titulo="Cómo se hacen"
    pasos={pasos}
    firma={`Detrás de ${sitio.nombre} está ${sitio.creador}: diseña, imprime y arma cada par. Si escribes por WhatsApp, te contesta en persona.`}
  />
  <Beneficios />
  <Personaliza />
  <Disenador />
  <Mayoreo />
  <Preguntas preguntas={sitio.preguntas.aretes} />
  <Visor elementos={elementosVisor} urlSitio={urlSitio} />
</Base>
