---
import Base from '@/layouts/Base.astro';
import HeroInicio from '@/components/inicio/HeroInicio.astro';
import Proceso from '@/components/Proceso.astro';
import { catalogo } from '@/data';
import { rutas } from '@/config/rutas';
import { sitio } from '@/config/sitio';

const productos = await catalogo.listarProductos();
const destacado = productos.find((p) => p.destacado && p.disponible) ?? productos.find((p) => p.disponible) ?? productos[0];

const pasos = [
  {
    titulo: 'Eliges',
    texto: 'Un modelo de aretes del catálogo, tu kit navideño o tu vela, con los colores, aromas y formas que quieras.',
  },
  {
    titulo: 'Lo hacemos a mano',
    texto: 'Cada pieza se imprime, se vierte o se arma a tu medida, y se revisa una por una antes de entregarla.',
  },
  {
    titulo: `Lo recoges en ${sitio.ciudad}`,
    texto: 'Te avisamos por WhatsApp cuando esté listo y quedamos en un punto de entrega.',
  },
];
---

<Base linea="inicio">
  <HeroInicio destacado={destacado} totalAretes={productos.length} />
  <Proceso
    id="asi-trabajamos"
    titulo="Así trabajamos"
    pasos={pasos}
    firma={`Detrás de ${sitio.nombre} está ${sitio.creador}: diseña y hace cada pieza. Si escribes por WhatsApp, te contesta en persona.`}
    alterna
  />
</Base>

<script is:inline define:vars={{ aretes: rutas.aretes }}>
  // Los enlaces de antes (cuando los aretes estaban en la portada) siguen funcionando:
  // `/#producto/<slug>`, `/?coleccion=…#catalogo`, etc. llevan a la página de aretes.
  if (/^#(producto\/|galeria|catalogo|personaliza|disena|mayoreo|proceso|beneficios|preguntas)/.test(location.hash) || /[?&]coleccion=/.test(location.search)) {
    location.replace(aretes + location.search + location.hash);
  }
</script>
